{
  "openapi": "3.0.3",
  "info": {
    "title": "Board",
    "version": "0.1.0",
    "description": "Goals and Bugs on GitHub. Writes need application/json and a trusted Origin."
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "No GitHub account connected / token refused"
          },
          "403": {
            "description": "GitHub token cannot do that"
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "summary": "Connection status for the signed-in person (never includes the token)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "No GitHub account connected / token refused"
          },
          "403": {
            "description": "GitHub token cannot do that"
          }
        }
      }
    },
    "/api/connect": {
      "post": {
        "summary": "Validate a GitHub personal access token with GET /user and store it 0600",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "No GitHub account connected / token refused"
          },
          "403": {
            "description": "GitHub token cannot do that"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/disconnect": {
      "post": {
        "summary": "Forget this person's token",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "No GitHub account connected / token refused"
          },
          "403": {
            "description": "GitHub token cannot do that"
          }
        }
      }
    },
    "/api/settings": {
      "post": {
        "summary": "Set the GitHub organisation",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "No GitHub account connected / token refused"
          },
          "403": {
            "description": "GitHub token cannot do that"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "org": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/board": {
      "get": {
        "summary": "Open/closed Goals and Bugs in the org",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "No GitHub account connected / token refused"
          },
          "403": {
            "description": "GitHub token cannot do that"
          }
        },
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": {
                "type": "string"
              }
            }
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": {
                "type": "string"
              }
            }
          },
          {
            "name": "accepted",
            "in": "query",
            "schema": {
              "type": {
                "type": "string"
              }
            }
          },
          {
            "name": "repo",
            "in": "query",
            "schema": {
              "type": {
                "type": "string"
              }
            }
          },
          {
            "name": "refresh",
            "in": "query",
            "schema": {
              "type": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "/api/issue": {
      "get": {
        "summary": "One goal or bug with done-list, PRs and comments",
        "responses": {
          "200": {
            "description": "OK",
