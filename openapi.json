    "/api/split": {
      "get": {
        "summary": "Goals or Bugs grouped by status: Waiting for review (ready-to-test, key test), Building (building), Queued (other open). Up to 300 items. Rows carry desc (first paragraph as plain text), assignees, comments (count). Also returns steps (the three workflow steps for this view), me_person, and per item opener (team name of whoever opened it); mine is true when you or your own agent opened it. 0.9: also returns targets (seconds per stage for this view: queued, building, review, done) and, for view=bugs, repos (every non-archived org repo as owner/name, cached an hour, so the Repo chips can show repos with 0 open bugs); items carry created_at and updated_at (bug age and sort are computed in the view).",
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "goals",
                "bugs"
              ]
            }
          },
          {
            "name": "refresh",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          },
          {
            "name": "repos",
            "in": "query",
            "description": "Optional comma-separated repo names to keep (the view filters itself).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "view, org, login, groups {test, building, queued} (each item: id, repo, number, title, author, assignees[], comments, desc, group, mine, labels; goals add progress, owner), counts, done (closed all time, null while stats are pending), stats (same shape as /api/stats, or {pending:true} until computed: then call /api/stats), total, shown, more; plus 0.3 keys test and doing. closed_week was removed in 0.5. 0.9 keys: targets {queued, building, review, done} in seconds; repos [owner/name] (bugs only, [] for goals)."
          }
        }
      }
    },
    "/api/detail": {
      "get": {
        "summary": "One issue in full for the in-app sheet: GitHub-rendered body and comments (cleaned HTML), author, dates, labels.",
        "parameters": [
          {
            "name": "repo",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "owner/name or a repo in the org"
          },
          {
            "name": "number",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "refresh",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "id, repo, number, title, url, state, author, created_at, updated_at, labels, body_html, comments [{author, created_at, url, body_html}], comments_total"
          },
          "404": {
            "description": "Not found or not visible to this token"
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "summary": "Bottleneck stats for one view from GitHub label history (LABELED/UNLABELED/CLOSED/REOPENED events), all open and closed issues of that kind, cached 5 minutes per account.",
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "goals",
                "bugs"
              ]
            }
          },
          {
            "name": "author",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repos",
            "in": "query",
            "description": "Comma-separated repo names.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "items [{id, repo, author, state, wait (s opened→first building), build (s first building→first ready-to-test), review_rounds ([s] each ready-to-test stint that ended in a close or kick-back), total (s opened→closed), tries (times labelled ready-to-test), kicks (ready-to-test removed without close/approved within 10 min), kick_to_done (s first kick-back→closed), waiting_for (s since ready-to-test, open items only), stage (queued|building|review|done), staged, opened_at, closed_at}], done, counted, total, computed_at, summary {wait_before_build, build_time, waiting_for_human, waiting_longest, tries_per_item, kicked_back, done, items, line {queued|building|review|done: {n, avg, box [min,p25,median,p75,max] or null under 3 points}, kick {reviewed, kicked, rate, per_item, to_done}}}. Null means no data yet. The view re-aggregates items after its author/repo filters with the same maths. 0.9: summary.line.<stage> also carries median, p25, p75 (p25/p75 from 3 data points)."
          }
        }
      }
    },
    "/api/builder": {
      "get": {
        "summary": "Wizard OS Builder switch (mock-up; the builder host will poll this). Default Paused.",
        "responses": {
          "200": {
            "description": "{running: bool, state: Running|Paused, updated_at, updated_by, connected: false, note}"
          }
        }
      },
      "post": {
        "summary": "Set the builder switch.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "running": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "running"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Same as GET."
          },
          "400": {
            "description": "running must be a boolean."
          }
        }
      }
    },
    "/api/policy": {
      "get": {
        "summary": "The workflow policy: team roster (person -> logins, agents), the builder, who opens each view, and the three steps (Open, Build, Review) per view. Defaults in code; DATA_DIR/policy.json overrides keys team, builder, open, targets.",
        "responses": {
          "200": {
            "description": "version 2; team [{name, logins, agents [{login, name}]}], builder {name, logins}, open {goals, bugs}, steps {goals: [step], bugs: [step]} where step = {key open|build|review, n, name, group queued|building|test, label, count_label, role, who [{name, logins [{login, kind person|agent, name}]}], except, about, next}, me {login, person}, org; 0.5 keys kept: goals.authors, builds.builders, lines. 0.9: targets {goals|bugs: {queued, building, review, done}} in seconds (defaults Bugs 1h/4h/1d/2d, Goals 1d/3d/3d/14d; policy.json may give seconds or '30m', '4h', '3d', '2w')."
          }
        }
      }
    },
    "/api/try": {
      "get": {
        "summary": "Try it choices of the signed-in person (mock-up). {items: {'owner/repo#12': {on: true, at}}, connected: false, note}",
        "responses": {
          "200": {
            "description": "Choices"
          }
        }
      },
      "post": {
        "summary": "Switch Try it on or off for one item (the view allows it only in Review, label ready-to-test).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "repo": {
                    "type": "string",
                    "description": "owner/name"
                  },
                  "number": {
                    "type": "integer"
                  },
                  "on": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "repo",
                  "number",
                  "on"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Same as GET plus key and on."
          },
          "400": {
            "description": "Bad repo, number or on."
          }
        }
      }
    },
    "/api/flow": {
      "get": {
        "summary": "One item's own assembly line from its GitHub REST timeline (labeled/unlabeled/closed/reopened), fetched on demand, cached 2 minutes.",
        "parameters": [
          {
            "name": "repo",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "owner/name or name in the org"
          },
          {
            "name": "number",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "refresh",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "{id, repo, number, state, stage (queued|building|review|done), spent {queued, building, review} seconds in each stage, staged (ever building/ready-to-test), wait, build, review_rounds, total, tries, kicks, kick_to_done, waiting_for, opened_at, closed_at (unix s), computed_at}"
          }
        }
      }
    },
    "/api/done": {
      "get": {
        "summary": "Most recently closed items of one view (up to 50, newest first) for the Done bin filter.",
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "goals",
                "bugs"
              ]
            }
          },
          {
            "name": "repos",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated repo names."
          },
          {
            "name": "refresh",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "{view, org, items [row cards + group \"done\", closed_at, state_reason, opener, mine], count, total}"
          }
        }
      }
    }
  }
}
