            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "No GitHub account connected / token refused"
          },
          "403": {
            "description": "GitHub token cannot do that"
          }
        },
        "parameters": [
          {
            "name": "repo",
            "in": "query",
            "schema": {
              "type": {
                "type": "string"
              }
            }
          },
          {
            "name": "number",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "fresh",
            "in": "query",
            "schema": {
              "type": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "/api/repos": {
      "get": {
